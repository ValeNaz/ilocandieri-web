# ---------------------------------------------------------------
# I Locandieri - environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Public base URL of the site (no trailing slash). Used for absolute links in emails, sitemap, canonical.
SITE_URL=http://localhost:3000

# Secret (min 16 chars, use 32+ random bytes) used to sign form tokens and hash IPs. REQUIRED in production.
# Generate: openssl rand -base64 32
APP_SECRET=

# Database. Local SQLite file by default; for Turso/remote libSQL use libsql://... and DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# First admin, created by `pnpm db:seed` (never hardcode credentials). Password min 10 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Amministratore
# Set to 1 to reset the password of an EXISTING admin to ADMIN_PASSWORD on next seed.
SEED_RESET_ADMIN_PASSWORD=

# Initial notification recipients (comma separated) for registrations/applications/contacts.
# Defaults to ADMIN_EMAIL. Editable later in admin > Impostazioni.
NOTIFY_EMAIL=

# SMTP for outgoing email. Leave SMTP_HOST empty = emails are stored in the outbox as "non configurata"
# (visible in admin, retry once configured).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); default: true only when port is 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "I Locandieri <noreply@ilocandieri.it>"
SMTP_FROM=

# File storage. Local driver: STORAGE_DIR/public-media (served at /media) and STORAGE_DIR/private (never public).
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Alternate Next.js build dir (parallel dev servers / e2e). Default .next
NEXT_DIST_DIR=

# Optional ABES (Shopify Storefront) credentials - used by the ABES module if provided.
ABES_SHOPIFY_DOMAIN=
ABES_SHOPIFY_STOREFRONT_TOKEN=
